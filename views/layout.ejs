<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'CyberSafe India | National Security Portal' %>
    </title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        india: {
                            saffron: '#FF9933',
                            white: '#FFFFFF',
                            green: '#138808',
                        },
                        material: {
                            bg: '#f5f5f5',
                            card: '#ffffff',
                            text: '#212121',
                            primary: '#FF9933',
                            secondary: '#138808',
                        }
                    },
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    },
                    boxShadow: {
                        'material': '0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12)',
                        'material-hard': '0 8px 17px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19)',
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Outfit:wght@700;800&display=swap"
        rel="stylesheet">

    <!-- AOS (Animate on Scroll) -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f5f5f5;
            color: #212121;
            overflow-x: hidden;
        }

        .hero-text {
            font-family: 'Outfit', sans-serif;
        }

        /* Material Sharp Components */
        .card-material {
            background-color: #ffffff;
            border-radius: 4px;
            box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 3px 1px -2px rgba(0, 0, 0, 0.12), 0 1px 5px 0 rgba(0, 0, 0, 0.2);
            transition: box-shadow 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-material:hover {
            box-shadow: 0 8px 17px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
        }

        .btn-material {
            text-transform: uppercase;
            font-weight: 500;
            padding: 10px 24px;
            border-radius: 2px;
            transition: 0.2s ease-out;
            box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 3px 1px -2px rgba(0, 0, 0, 0.12), 0 1px 5px 0 rgba(0, 0, 0, 0.2);
        }

        .btn-material:active {
            box-shadow: 0 4px 5px 0 rgba(0, 0, 0, 0.14), 0 1px 10px 0 rgba(0, 0, 0, 0.12), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
        }

        /* Tiranga Accents */
        .border-tiranga {
            border-top: 4px solid #FF9933;
            border-bottom: 4px solid #138808;
        }
        /* ── Google Translate Resets ── */
        .goog-te-gadget-simple {
            background-color: transparent !important;
            border: none !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
        }
        .goog-te-gadget-simple span {
            color: #212121 !important;
            font-family: 'Outfit', sans-serif !important;
            font-size: 14px !important;
            font-weight: 800 !important;
            text-transform: uppercase;
            border: none !important;
        }
        .goog-te-menu-value { display: flex !important; align-items: center !important; }
        .goog-te-menu-value span { border: none !important; padding: 0 !important; margin: 0 !important; }
        .goog-te-menu-value img { display: none !important; }
        .goog-te-gadget-icon { display: none !important; }
        .goog-tooltip { display: none !important; }
        .goog-tooltip:hover { display: none !important; }
        .goog-text-highlight { background-color: transparent !important; border: none !important; box-shadow: none !important; }
        iframe.skiptranslate { display: none !important; }
        body { top: 0 !important; } /* Fix top padding added by google translate */
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('partials/navbar') %>

        <main class="flex-grow pt-16">
            <%- body %>
        </main>

        <%- include('partials/footer') %>

        <!-- Floating Language Selector -->
        <div class="fixed bottom-8 right-6 z-[300] bg-white rounded-full shadow-material-hard border-2 border-slate-100 flex items-center justify-center pl-4 pr-5 py-2 hover:shadow-lg transition-all hover:scale-105 cursor-pointer">
            <i class="fa-solid fa-language text-xl text-india-saffron mr-2"></i>
            <div id="google_translate_element" style="overflow:hidden;"></div>
        </div>

            <!-- Scripts -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
            <script type="text/javascript">
                function googleTranslateElementInit() {
                    new google.translate.TranslateElement({
                        pageLanguage: 'en',
                        includedLanguages: 'hi,mr,bn,te,ta,gu,ur,kn,or,ml,pa',
                        layout: google.translate.TranslateElement.InlineLayout.SIMPLE
                    }, 'google_translate_element');
                }
            </script>
            <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
            <script src="/js/script.js"></script>
</body>

</html>